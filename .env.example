# Copy to .env.local for dev, or paste into Vercel's project settings.
# Every value here has a working default EXCEPT DATABASE_URL.

# --- Database ---------------------------------------------------------------
# On serverless (Vercel), point this at Supabase's TRANSACTION POOLER (port
# 6543), not the direct connection: every concurrent function gets its own
# pool, and the direct port runs out of connections. Our writes are all short
# transactions, so transaction-mode pooling is compatible.
DATABASE_URL=postgres://user:pass@host:6543/postgres

# Migrations need a DIRECT connection (port 5432) -- drizzle-kit takes locks
# a transaction pooler will not carry.
DIRECT_URL=postgres://user:pass@host:5432/postgres

# --- Tenancy ----------------------------------------------------------------
# The apex a salon's subdomain hangs off: ovarya.<apex>/book.
#
# Leave it unset until a domain exists. The public page ALSO answers on the
# plain path /book/<slug>, so the demo works on *.vercel.app today; pointing a
# wildcard (*.example.com) at the project is what turns the subdomain form on,
# and needs a plan tier that allows wildcard domains.
# NEXT_PUBLIC_APEX_HOST=atjelita.com

# --- Notifications ----------------------------------------------------------
# Vercel Cron sends `Authorization: Bearer $CRON_SECRET` to
# /api/cron/notifications. UNSET means the route refuses every request (503)
# and nothing is dispatched on a timer -- visible as a growing queue of due
# messages in the Notification Center.
CRON_SECRET=

# --- Object storage ---------------------------------------------------------
# Salon logos. Any S3-compatible store: MinIO in dev (docker-compose.test.yml),
# Cloudflare R2 or Supabase Storage in production.
S3_ENDPOINT=http://127.0.0.1:59000
S3_BUCKET=jelita-assets
S3_REGION=us-east-1
S3_ACCESS_KEY=jelita
S3_SECRET_KEY=jelitajelita

# --- Analytics --------------------------------------------------------------
# GTM on the PUBLIC booking page only. Unset means no analytics at all, which
# is what dev and CI want.
# NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
